    "installer": {
        "script": [
            "# 静默安装到指定目录",
            "Start-Process -Wait -FilePath \"$dir\\jdk-6u45-windows-x64.exe\" -ArgumentList '/s', \"INSTALLDIR=$dir\\jdk\"",
            "# 等待安装完成",
            "while (!(Test-Path \"$dir\\jdk\\bin\\java.exe\")) { Start-Sleep -Seconds 2 }"
        ]
    },
    "env_add_path": "jdk\\bin",
    "env_set": {
        "JAVA_HOME": "$dir\\jdk"
    }
}
